{
  "manifest_version": 3,
  "name": "Claude Conversation Exporter",
  "version": "1.0",
  "description": "Export Claude conversations to JSON for continuum logs",
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://claude.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://claude.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "icons": {
    "48": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-exporter@willnapier",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
