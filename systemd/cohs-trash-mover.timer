[Unit]
Description=Run cohs-trash-mover every 5 minutes

[Timer]
# Fire 1 min after boot, then every 5 min. Same cadence as Mac launchd.
# Converted from monotonic OnBootSec/OnUnitActiveSec 2026-08-02 (boot-race class, review F1 — see continuum-auto-import.timer for the full explanation)
OnCalendar=*:0/5
Persistent=true

[Install]
WantedBy=timers.target
