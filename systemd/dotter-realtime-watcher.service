[Unit]
Description=Dotter Real-time Configuration Watcher
Documentation=file:///home/%i/Claude/REAL-TIME-CONFIG-ONBOARDING-SYSTEM.md
# This is a headless default-target service. It must not pull in
# graphical-session.target: niri.service owns that target and reaches it only
# after the compositor has published its display environment. Pulling it in at
# user-manager startup makes every GUI service race the compositor.

[Service]
Type=simple
ExecStart=%h/.local/bin/dotter-realtime-watcher
Restart=always
RestartSec=5
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin:/sbin
Environment=HOME=%h

# Logging
StandardOutput=append:%h/.local/share/dotter-realtime-watcher.stdout
StandardError=append:%h/.local/share/dotter-realtime-watcher.stderr

# Performance optimizations
Nice=15
IOSchedulingClass=3
IOSchedulingPriority=7

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# recognition-only since 2026-09-02: it never writes into ~/dotfiles; .local/state holds the heartbeat
ReadWritePaths=%h/.local/share %h/.local/state /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=default.target
