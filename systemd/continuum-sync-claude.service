[Unit]
Description=Continuum Claude Code Sync
After=network.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/continuum-sync-claude
# The script keeps its own sync.log; anything it prints or panics lands there too
# (systemd.log stayed 0 bytes for ten months — review F10, 2026-09-02).
StandardOutput=append:%h/.local/share/continuum/sync.log
StandardError=append:%h/.local/share/continuum/sync.log

[Install]
WantedBy=default.target
