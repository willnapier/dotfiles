[Unit]
Description=Alert if configured Rustic backups are stale

[Service]
Type=oneshot
Environment=HOME=/home/will
Environment=PATH=/home/will/.cargo/bin:/home/will/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/home/will/.local/bin/rustic-backup status

