[Unit]
Description=PracticeForge Dashboard
# The dashboard can serve headlessly, but its attended TM3 renewal path launches
# a visible passkey browser. Starting from default.target races Niri's display
# environment import and leaves the long-running process without DISPLAY or
# WAYLAND_DISPLAY for its entire lifetime.
After=network.target graphical-session.target

[Service]
ExecStart=%h/.local/bin/practiceforge admin-dashboard --port 3457
Restart=on-failure
RestartSec=5

[Install]
# niri.service reaches this target only after importing the display environment.
# Do not add PartOf=graphical-session.target: after this ordered start the local
# dashboard should remain available if the compositor is restarted.
WantedBy=graphical-session.target
