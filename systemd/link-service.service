[Unit]
Description=Wiki Link Management Service (backlinks + resolve-mark)
After=default.target

[Service]
# wiki-link-service (Rust, 2026-09-02): one foreground process, two watcher threads.
Type=simple
ExecStart=%h/.local/bin/wiki-link-service start
Restart=on-failure
RestartSec=10
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
