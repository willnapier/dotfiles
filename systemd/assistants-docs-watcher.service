[Unit]
Description=Assistants Git historian (nimbini only)
Documentation=file://%h/Assistants/shared/ASSISTANTS-DOCS-AUTO-PUSH.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/assistants-git-sync --role historian --expected-host nimbini --repo %h/Assistants --log %h/.local/share/assistants-git-sync-historian.log
Restart=always
RestartSec=10
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h

# Logging
StandardOutput=journal
StandardError=journal

# Nice to have
Nice=15

[Install]
WantedBy=default.target
