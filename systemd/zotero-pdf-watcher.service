[Unit]
Description=Zotero PDF Watcher (zotero-watcher pdf, Rust)
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/zotero-watcher pdf
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

Environment="PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOME=%h"

[Install]
WantedBy=default.target