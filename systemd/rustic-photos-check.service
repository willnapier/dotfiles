[Unit]
Description=Check the Rustic photograph repository structure and integrity
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/home/will
Environment=PATH=/home/will/.cargo/bin:/home/will/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUSTIC_BACKUP_PROFILE=nimbini-photos
Environment=RUSTIC_BACKUP_MAX_AGE=777600
ExecStart=/home/will/.local/bin/rustic-backup check
TimeoutStartSec=12h
StandardOutput=append:/home/will/.local/share/rustic-photos-check.log
StandardError=append:/home/will/.local/share/rustic-photos-check.log
