# Cross-machine SSH aliases (dotter-managed)
# Hosts are addressed by Tailscale MagicDNS name, never by address: this file
# is in a public repository, and names resolve only for tailnet members
# (verified both directions 2026-09-02 with the config bypassed).

# Mac
Host mac Mac williams-macbook-air
    HostName williams-macbook-air
    User williamnapier
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Linux desktop
Host nimbini
    HostName nimbini
    User will
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Defaults
Host *
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
