#!/usr/bin/env bash
# Mod+Alt+Shift+direction: context-sensitive *move* (matches tiling move chord).
#   floating focused → nudge floating window position (logical px)
#   tiling focused   → move column / window within structure
#
# Usage: niri-move-dir left|right|up|down
# Step: NIRI_FLOAT_NUDGE_STEP (default 50)
set -euo pipefail

dir="${1:-}"
step="${NIRI_FLOAT_NUDGE_STEP:-50}"

if [[ -z "$dir" ]]; then
  echo "usage: niri-move-dir left|right|up|down" >&2
  exit 2
fi

is_float=$(niri msg --json focused-window 2>/dev/null | jq -r '.is_floating // false')

if [[ "$is_float" == "true" ]]; then
  case "$dir" in
    left)  niri msg action move-floating-window -x "-${step}" -y +0 ;;
    right) niri msg action move-floating-window -x "+${step}" -y +0 ;;
    up)    niri msg action move-floating-window -x +0 -y "-${step}" ;;
    down)  niri msg action move-floating-window -x +0 -y "+${step}" ;;
    *)
      echo "unknown direction: $dir" >&2
      exit 2
      ;;
  esac
else
  case "$dir" in
    left)  niri msg action move-column-left ;;
    right) niri msg action move-column-right ;;
    up)    niri msg action move-window-up ;;
    down)  niri msg action move-window-down ;;
    *)
      echo "unknown direction: $dir" >&2
      exit 2
      ;;
  esac
fi
