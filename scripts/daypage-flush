#!/usr/bin/env nu
# Acknowledge entries already saved to disk. Never modify DayPages externally.
# Import pending entries in the relevant Helix buffer with Space+U, then :w.
def main [] {
    ^wiki-link-service daypage-ack
    if $env.LAST_EXIT_CODE != 0 { error make { msg: "DayPage acknowledgement failed; queue retained" } }
}
