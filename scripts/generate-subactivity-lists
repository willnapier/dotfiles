#!/usr/bin/env nu

# Maintain ## Sub-activities hub lists on parent activity/person logs.
#
# Decided 2026-08-21 (`qtrack-parent-child-logs`): a parent file is a hub —
# residual parent-key journal plus a complete clickable index of immediate
# dotted children. No on-disk rollup of child journals.
#
# Discovery is filename-based, not **Parent**: [[…]] (that field is incomplete
# and often points at the wrong altitude). `jenny.tv.md` → parent `jenny`;
# `jenny.tv.diet.md` → parent `jenny.tv`. Scans NapierianLogs/*.md and
# Social/*.md. Refreshes ## Sub-activities every run (the old {Auto-generated}
# placeholder was one-shot and then froze).
#
# Usage:
#   generate-subactivity-lists            # Update parent hub lists
#   generate-subactivity-lists --dry-run  # Preview without writing
#   generate-subactivity-lists --verbose  # Show parents and children

def immediate_parent [stem: string] {
    let parts = ($stem | split row '.')
    if ($parts | length) < 2 {
        null
    } else {
        $parts | drop 1 | str join '.'
    }
}

def is_activity_log [path: string] {
    let base = ($path | path basename)
    if ($base | str starts-with '.') { return false }
    if ($base | str contains 'sync-conflict') { return false }
    ($base | str ends-with '.md')
}

# Activity keys only: jenny.tv, ex.walk — not "Note from Spain.foo" or "C.S".
def is_dotted_key [stem: string] {
    $stem =~ '^[a-z][a-z0-9-]*(\.[a-z][a-z0-9-]+)+$'
}

def replace_subactivities [content: string, child_list: string] {
    let child_lines = ($child_list | lines)
    mut out = []
    mut in_section = false
    mut replaced = false

    for line in ($content | lines) {
        if $line == "## Sub-activities" {
            $out = ($out | append "## Sub-activities" | append "" | append $child_lines)
            $in_section = true
            $replaced = true
            continue
        }
        if $in_section {
            if ($line | str starts-with "## ") {
                $in_section = false
                $out = ($out | append "" | append $line)
            }
            continue
        }
        $out = ($out | append $line)
    }

    if not $replaced {
        mut inserted = false
        mut with_section = []
        for line in $out {
            if (not $inserted) and ($line == "## Journal Entries") {
                $with_section = (
                    $with_section
                    | append "## Sub-activities"
                    | append ""
                    | append $child_lines
                    | append ""
                    | append $line
                )
                $inserted = true
            } else {
                $with_section = ($with_section | append $line)
            }
        }
        if $inserted {
            $out = $with_section
        } else {
            $out = (
                $out
                | append ""
                | append "## Sub-activities"
                | append ""
                | append $child_lines
            )
        }
    }

    ($out | str join "\n") + "\n"
}

def main [
    --dry-run (-d)
    --verbose (-v)
] {
    let forge_dir = $"($env.HOME)/Forge/NapierianLogs"
    let social_dir = $"($forge_dir)/Social"

    if $verbose {
        print $"Scanning ($forge_dir) and Social/ for dotted children..."
    }

    let files = (
        (glob $"($forge_dir)/*.md")
        | append (if ($social_dir | path exists) { glob $"($social_dir)/*.md" } else { [] })
        | where {|f| is_activity_log $f }
    )

    let parent_map = (
        $files
        | each {|file|
            let stem = ($file | path basename | str replace -r '\.md$' '')
            if not (is_dotted_key $stem) {
                null
            } else {
                let parent = (immediate_parent $stem)
                if $parent == null {
                    null
                } else {
                    {child: $stem, parent: $parent, dir: ($file | path dirname)}
                }
            }
        }
        | compact
        | group-by parent
        | transpose key children
        | each {|row|
            {
                parent: $row.key
                children: ($row.children | get child | uniq | sort)
                dirs: ($row.children | get dir | uniq)
            }
        }
    )

    if $verbose {
        print $"Found ($parent_map | length) parents with children:"
        $parent_map | each {|p|
            print $"  ($p.parent): ($p.children | length) children"
        }
    }

    let updates = (
        $parent_map | each {|entry|
            let parent_file_root = $"($forge_dir)/($entry.parent).md"
            let parent_file_social = $"($social_dir)/($entry.parent).md"

            # A missing parent is created as a minimal hub (forum decision
            # 2026-08-21: parent key:: files are hubs). Before 2026-09-02 it was
            # only warned about — 3,561 "Parent file not found" lines in the
            # collect log and the children never linked (review D1-7). It goes
            # where its children live: Social/ if all of them do, else root.
            let parent_file = if ($parent_file_root | path exists) {
                $parent_file_root
            } else if ($parent_file_social | path exists) {
                $parent_file_social
            } else {
                let all_social = ($entry.dirs | all {|d| $d == $social_dir })
                let target = if $all_social { $parent_file_social } else { $parent_file_root }
                if $verbose {
                    print $"🆕 Parent hub missing, will create: ($target)"
                }
                $target
            }

            {
                let content = if ($parent_file | path exists) { open $parent_file } else { $"# ($entry.parent)\n" }
                let child_list = (
                    $entry.children
                    | each {|child| $"- [[($child)]]" }
                    | str join "\n"
                )
                let new_content = (replace_subactivities $content $child_list)
                if $new_content == $content {
                    if $verbose {
                        print $"⏭️  Unchanged: ($entry.parent).md"
                    }
                    null
                } else {
                    {
                        file: $parent_file
                        parent: $entry.parent
                        children: $entry.children
                        new_content: $new_content
                    }
                }
            }
        }
        | compact
    )

    if ($updates | is-empty) {
        print "✅ No hub lists to update"
        return
    }

    print $"\n📋 Hub lists to update:"
    $updates | each {|u|
        print $"  ($u.parent): ($u.children | length) children"
        if $verbose {
            $u.children | each {|c| print $"    - [[($c)]]" }
        }
    }

    if $dry_run {
        print $"\n🔍 DRY RUN — no files written \(($updates | length) would change\)"
        return
    }

    print $"\n✏️  Updating ($updates | length) parent files..."
    $updates | each {|u|
        $u.new_content | save -f $u.file
        if $verbose {
            print $"  ✅ ($u.file)"
        }
    }

    print $"\n✅ Done. Updated ($updates | length) hub lists."
}
