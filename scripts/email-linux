#!/usr/bin/env bash
# email — open MailForge in the browser on Linux/niri. Deployed to
# ~/.local/bin/email via [linux.files] so the command name matches
# the macOS launcher.
#
# Starting an already-active service is a no-op. Provider sync stays with
# its timers and MailForge's account-specific Refresh action.
set -euo pipefail
systemctl --user start mailforge.service
exec xdg-open "http://127.0.0.1:8765"
