#!/bin/bash
# Space+n: open the wiki bridge target in a new Zellij tab, or a new WezTerm tab.
set -euo pipefail
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
    _dir="$(cd "$(dirname "$_self")" && pwd)"
    _self="$(readlink "$_self")"
    case "$_self" in
        /*) ;;
        *) _self="$_dir/$_self" ;;
    esac
done
# shellcheck source=hx-wiki-open-lib
source "$(cd "$(dirname "$_self")" && pwd)/hx-wiki-open-lib"

target=$(hx_wiki_resolve_bridge) || exit 1
hx_wiki_open_target tab "$target"
