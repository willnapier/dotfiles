#!/usr/bin/env python3
"""Map Chocofi-Handy F20/F19 to Handy CLI, bypassing niri keybinds.

Matches the BLE keyboard by name (event node numbers change on re-pair).
KEY_F20 -> handy --toggle-transcription
KEY_F19 -> handy --cancel
"""

from __future__ import annotations

import os
import signal
import struct
import subprocess
import sys
import time
from pathlib import Path

DEVICES = Path("/proc/bus/input/devices")
EVENT_FMT = struct.Struct("llHHi")
EV_KEY = 1
KEY_F19 = 189
KEY_F20 = 190
NAMES = ("Chocofi-Handy Keyboard", "Chocofi-Handy", "Urchin-Turn Keyboard", "Urchin-Turn")


# Reap children automatically. Every F19/F20 press Popen()s a `handy` CLI
# invocation and never wait()s on it, so each press used to leave a zombie
# ([handy] <defunct>) holding a PID until this service restarted. Setting
# SIGCHLD to SIG_IGN tells the kernel we will never collect exit statuses,
# so it discards them itself instead of keeping the record.
#
# Safe here ONLY because nothing in this file ever calls wait()/poll() or
# reads a returncode - SIG_IGN makes those unreliable. If that ever changes,
# remove this and reap explicitly.
signal.signal(signal.SIGCHLD, signal.SIG_IGN)


def handy_bin() -> str:
    home = Path.home() / ".local/bin/handy"
    if home.is_file():
        return str(home)
    return "handy"


def handy_alive() -> bool:
    """Is there a Handy instance for the CLI to talk to?"""
    # -x matches the process NAME exactly. Do NOT use `pgrep -f "handy ..."`:
    # -f matches full command lines, so any shell or script mentioning that
    # string - including the command doing the checking - matches itself and
    # the guard reports "alive" when nothing is running. That self-match was
    # hit three separate times on 2026-08-28 (pkill -f, pgrep -c -f, and this
    # check), each time producing a confidently wrong answer.
    r = subprocess.run(
        ["pgrep", "-x", "handy"],
        capture_output=True,
        check=False,
    )
    return r.returncode == 0


def invoke(args: list[str]) -> None:
    # NEVER let this cold-start Handy. `handy --toggle-transcription` with no
    # running instance starts the app OUTSIDE handy.service, and that orphan
    # then wins Handy's single-instance check - so the service's own start
    # exits 0, Restart=always fires again, and it loops forever. Observed
    # 2026-08-28: 30 restarts in three minutes, beeping on every F20 with no
    # transcription, after a key press landed in a restart window.
    #
    # Ask systemd for an instance and drop this press. A lost keystroke is a
    # far cheaper failure than a restart loop that looks like working audio.
    if not handy_alive():
        print(
            "chocofi-handy-bind: no Handy instance; starting handy.service, "
            "press dropped",
            file=sys.stderr,
            flush=True,
        )
        subprocess.run(
            ["systemctl", "--user", "start", "handy.service"],
            capture_output=True,
            check=False,
        )
        return

    env = os.environ.copy()
    path = env.get("PATH", "")
    extra = str(Path.home() / ".local/bin")
    if extra not in path.split(":"):
        env["PATH"] = extra + ":" + path
    try:
        subprocess.Popen(
            args,
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        print(f"chocofi-handy-bind: spawn failed: {exc}", file=sys.stderr)


def all_event_nodes() -> list[str]:
    text = DEVICES.read_text(errors="replace")
    found: list[str] = []
    seen: set[str] = set()
    for block in text.split("\n\n"):
        name_line = next((ln for ln in block.splitlines() if ln.startswith("N: Name=")), "")
        if not any(n in name_line for n in NAMES):
            continue
        for line in block.splitlines():
            if not line.startswith("H: Handlers="):
                continue
            for tok in line.split("=", 1)[1].split():
                if tok.startswith("event"):
                    path = f"/dev/input/{tok}"
                    if path not in seen:
                        seen.add(path)
                        found.append(path)
    return found


def read_loop(path: str) -> None:
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    try:
        buf = b""
        while True:
            try:
                chunk = os.read(fd, EVENT_FMT.size * 8)
            except BlockingIOError:
                time.sleep(0.02)
                continue
            if not chunk:
                return
            buf += chunk
            while len(buf) >= EVENT_FMT.size:
                rec, buf = buf[: EVENT_FMT.size], buf[EVENT_FMT.size :]
                _sec, _usec, ev_type, code, value = EVENT_FMT.unpack(rec)
                if ev_type != EV_KEY or value != 1:
                    continue
                if code == KEY_F20:
                    invoke([handy_bin(), "--toggle-transcription"])
                elif code == KEY_F19:
                    invoke([handy_bin(), "--cancel"])
    finally:
        os.close(fd)


def main() -> int:
    print("chocofi-handy-bind: watching for Chocofi-Handy / Urchin-Turn F20/F19", flush=True)
    while True:
        nodes = all_event_nodes()
        if not nodes:
            time.sleep(1.0)
            continue
        # Prefer the Keyboard node if several exist
        path = next((p for p in nodes if True), nodes[0])
        print(f"chocofi-handy-bind: reading {path}", flush=True)
        try:
            read_loop(path)
        except OSError as exc:
            print(f"chocofi-handy-bind: {path} went away ({exc})", flush=True)
        time.sleep(0.3)
    return 0


if __name__ == "__main__":
    sys.exit(main())
