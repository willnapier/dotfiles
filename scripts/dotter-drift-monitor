#!/usr/bin/env nu

# dotter-drift-monitor — stateless "deployed vs intended" check for Dotter.
#
# Rewritten 2026-09-01. The previous version kept an mtime baseline created by
# `--setup` and compared against it forever. Two defects made it a checker that
# could not fail:
#   * the config path lacked $HOME, so the baseline was `[]`, the loop ran zero
#     times, and nimbini printed "No drift detected" four times a day for eight
#     months while checking nothing;
#   * the baseline was never refreshed, so on the Mac (where it did have
#     entries) every redeploy flagged every file forever — a 60-second daemon
#     wrote ~2 GB of "DRIFT DETECTED" lines about nothing.
#
# This version reads INTENT from ~/dotfiles/.dotter/global.toml on every run and
# compares it with what is on disk. No baseline, no --setup, no daemon.
#
# Verdicts per deployed file:
#   OK             symlink resolves to the dotfiles source (or template → regular file)
#   NOT-SYMLINK    a regular file/dir sits where a symlink should — THE drift case
#   WRONG-TARGET   symlink exists but resolves elsewhere
#   BROKEN-LINK    symlink exists but its target is gone
#   TGT-MISSING    nothing deployed at the target path
#   SRC-MISSING    global.toml names a source that is not in the repo
#
# Exit codes: 0 clean · 1 drift found · 2 could not check (config unreadable,
# zero mappings evaluated). A zero denominator is an error, never a pass.
#
# `--self-test` builds a throwaway fixture with deliberate drift and asserts the
# checker reports every verdict class and the zero-denominator error — proof
# that the checker can fail. system-health-check should run it.

def main [
    --check (-c)          # Accepted for compatibility with the systemd unit; the check is the default
    --json (-j)           # Emit the result record as JSON
    --quiet (-q)          # Print only problems and the summary line
    --self-test           # Prove the checker can fail, then exit (0 = proof held)
    --dotfiles: string    # Override the dotfiles root (used by --self-test)
    --home: string        # Override home for `~` expansion (used by --self-test)
] {
    if $self_test {
        exit (run_self_test)
    }

    let df = ($dotfiles | default $"($env.HOME)/dotfiles")
    let hm = ($home | default $env.HOME)
    let live = ($dotfiles == null)

    let result = (run_check $df $hm $quiet)

    if $live and ($result.drift | is-not-empty) {
        notify $"($result.drift | length) dotter-managed files have drifted \(see dotter-drift-monitor\)"
    }
    if $live {
        side_checks $df
    }
    if $json {
        print ($result | to json)
    }
    exit $result.exit_code
}

# ---------------------------------------------------------------------------
# Core check
# ---------------------------------------------------------------------------

def run_check [df: string, hm: string, quiet: bool] {
    let config_path = $"($df)/.dotter/global.toml"
    let local_path = $"($df)/.dotter/local.toml"

    if not ($config_path | path exists) {
        print $"❌ CANNOT CHECK: ($config_path) not found"
        return { exit_code: 2, evaluated: 0, ok: 0, drift: [], packages: [] }
    }
    let config = (try { open $config_path } catch { null })
    if $config == null {
        print $"❌ CANNOT CHECK: ($config_path) does not parse as TOML"
        return { exit_code: 2, evaluated: 0, ok: 0, drift: [], packages: [] }
    }
    let local_packages = if ($local_path | path exists) {
        (try { open $local_path | get -o packages | default [] } catch { [] })
    } else {
        []
    }

    let packages = (resolve_packages $config $local_packages)
    let auto_template = (($config | get -o settings.default_target_type | default "automatic") == "automatic")
    let mappings = (collect_mappings $config $packages $df $hm)
    let rows = ($mappings | each {|m| evaluate $m $auto_template })

    let evaluated = ($rows | length)
    let drift = ($rows | where verdict != "OK")
    let ok = ($evaluated - ($drift | length))

    if $evaluated == 0 {
        print $"❌ CANNOT CHECK: zero mappings evaluated for packages ($packages | str join ', ') — refusing to report clean"
        return { exit_code: 2, evaluated: 0, ok: 0, drift: [], packages: $packages }
    }

    if not $quiet {
        print $"🔍 dotter-drift-monitor — packages: ($packages | str join ', ')"
    }
    for row in $drift {
        let shown = ($row.tgt | str replace $hm "~")
        print $"❌ ($row.verdict | fill -w 12)  ($shown)  \(($row.entry)\)($row.detail)"
    }
    let exit_code = if ($drift | is-empty) { 0 } else { 1 }
    let status = if $exit_code == 0 { "✅ clean" } else { $"🚨 ($drift | length) drifted" }
    print $"($status) — checked ($evaluated) deployed files, ($ok) OK"

    { exit_code: $exit_code, evaluated: $evaluated, ok: $ok, drift: $drift, packages: $packages }
}

# Packages to evaluate: `shared` plus local.toml's packages plus their
# transitive `depends`. Only packages that actually carry a `files` table count.
def resolve_packages [config: record, local_packages: list<string>] {
    mut wanted = (["shared"] | append $local_packages | uniq)
    mut frontier = $wanted
    loop {
        let deps = (
            $frontier
            | each {|p| $config | get -o $p | default {} | get -o depends | default [] }
            | flatten
            | where $it != "default"
            | uniq
        )
        let fresh = ($deps | where $it not-in $wanted)
        if ($fresh | is-empty) { break }
        $wanted = ($wanted | append $fresh)
        $frontier = $fresh
    }
    $wanted | where {|p| ($config | get -o $p | default {} | get -o files) != null }
}

# Expand every `[<pkg>.files]` entry into one row per deployed FILE. A directory
# source is deployed by dotter as one link per file underneath it, so it is
# walked here the same way.
def collect_mappings [config: record, packages: list<string>, df: string, hm: string] {
    $packages | each {|p|
        let files = ($config | get $p | get -o files | default {})
        $files | transpose src tgt | each {|e|
            let is_plain = (($e.tgt | describe) == "string")
            let tgt_raw = if $is_plain { $e.tgt } else { ($e.tgt | get -o target | default "") }
            let kind = if $is_plain { "auto" } else { ($e.tgt | get -o type | default "auto") }
            let src_abs = $"($df)/($e.src)"
            let tgt_abs = ($tgt_raw | str replace --regex '^~' $hm)
            if ($src_abs | path type) == "dir" {
                # glob returns canonical paths, so canonicalise the base too or
                # `path relative-to` fails on macOS (/var vs /private/var).
                let base = ($src_abs | path expand)
                glob --no-dir $"($base)/**/*" | each {|f|
                    let rel = ($f | path relative-to $base)
                    { pkg: $p, entry: $e.src, src: $f, tgt: ($tgt_abs | path join $rel), kind: $kind }
                }
            } else {
                [{ pkg: $p, entry: $e.src, src: $src_abs, tgt: $tgt_abs, kind: $kind }]
            }
        } | flatten
    } | flatten
}

def evaluate [m: record, auto_template: bool] {
    if not ($m.src | path exists) {
        return ($m | merge { verdict: "SRC-MISSING", detail: "" })
    }
    let kind = if $m.kind != "auto" {
        $m.kind
    } else if $auto_template and (is_template $m.src) {
        "template"
    } else {
        "symbolic"
    }
    # `path type` yields null (not "") for a missing path
    let tgt_type = ($m.tgt | path type | default "")

    if $kind == "template" {
        let verdict = if $tgt_type == "file" { "OK" } else if $tgt_type == "" { "TGT-MISSING" } else { "NOT-FILE" }
        return ($m | merge { verdict: $verdict, detail: " [template]" })
    }

    let verdict_detail = if $tgt_type == "" {
        ["TGT-MISSING", ""]
    } else if $tgt_type != "symlink" {
        ["NOT-SYMLINK", $" [($tgt_type)]"]
    } else {
        let resolved = (ls -l $m.tgt | get 0.target | default "")
        if not ($resolved | path exists) {
            ["BROKEN-LINK", $" → ($resolved)"]
        } else if ($resolved | path expand) == ($m.src | path expand) {
            ["OK", ""]
        } else {
            ["WRONG-TARGET", $" → ($resolved)"]
        }
    }
    $m | merge { verdict: $verdict_detail.0, detail: $verdict_detail.1 }
}

# Dotter's `automatic` target type deploys a file as a template (rendered
# regular file) when it contains the handlebars opener, otherwise as a symlink.
# The opener is assembled at runtime so this script never contains it
# literally — otherwise dotter would template THIS file on the next deploy.
def handlebars_opener [] { "{" + "{" }

def is_template [src: string] {
    try {
        (open --raw $src | decode utf-8 | str contains (handlebars_opener))
    } catch {
        false
    }
}

# ---------------------------------------------------------------------------
# Side checks kept from the old script (warnings only; never affect exit code)
# ---------------------------------------------------------------------------

def side_checks [df: string] {
    let uncommitted = (do { git -C $df status --porcelain } | complete)
    if ($uncommitted.stdout | str trim | is-not-empty) {
        print "⚠️  Uncommitted changes in ~/dotfiles — commit or lose them on next pull"
        print $uncommitted.stdout
        notify "Uncommitted changes in ~/dotfiles"
    }
    let helix_check = $"($env.HOME)/.local/bin/helix-config-sync-check"
    if ($helix_check | path exists) {
        let r = (do { nu $helix_check } | complete)
        if $r.exit_code != 0 {
            print "⚠️  Helix configs are out of sync!"
            print $r.stdout
        }
    }
}

def notify [msg: string] {
    if (which notify-send | is-not-empty) {
        do { notify-send -u critical "Dotter drift" $msg } | ignore
    } else if (which osascript | is-not-empty) {
        do { osascript -e $'display notification "($msg)" with title "Dotter drift"' } | ignore
    }
}

# ---------------------------------------------------------------------------
# Self-test: the checker must be able to fail
# ---------------------------------------------------------------------------

def run_self_test [] {
    let root = (mktemp -d)
    let df = $"($root)/dotfiles"
    let hm = $"($root)/home"
    mkdir $"($df)/.dotter" $"($df)/hooks" $"($hm)/.config/hooks"

    "ok" | save $"($df)/good.txt"
    "drift" | save $"($df)/bad.txt"
    "hook" | save $"($df)/hooks/h1.sh"
    "gone" | save $"($df)/gone.txt"
    "wrong" | save $"($df)/wrong.txt"
    "broken" | save $"($df)/broken.txt"
    "mac" | save $"($df)/mac.txt"
    $"name = (handlebars_opener) name }}" | save $"($df)/tpl.conf"

    [
        '[shared.files]'
        '"good.txt" = "~/.config/good.txt"'
        '"bad.txt" = "~/.config/bad.txt"'
        '"hooks" = "~/.config/hooks"'
        '"gone.txt" = "~/.config/gone.txt"'
        '"wrong.txt" = { target = "~/.config/wrong.txt", type = "symbolic" }'
        '"broken.txt" = "~/.config/broken.txt"'
        '"ghost.txt" = "~/.config/ghost.txt"'
        '"tpl.conf" = "~/.config/tpl.conf"'
        '[macos.files]'
        '"mac.txt" = "~/.config/mac.txt"'
        '[settings]'
        'default_target_type = "automatic"'
    ] | str join "\n" | save $"($df)/.dotter/global.toml"
    'packages = []' | save $"($df)/.dotter/local.toml"

    ^ln -s $"($df)/good.txt" $"($hm)/.config/good.txt"
    ^cp $"($df)/bad.txt" $"($hm)/.config/bad.txt"
    ^ln -s $"($df)/hooks/h1.sh" $"($hm)/.config/hooks/h1.sh"
    ^ln -s $"($df)/bad.txt" $"($hm)/.config/wrong.txt"
    ^ln -s $"($root)/nowhere" $"($hm)/.config/broken.txt"
    "rendered" | save $"($hm)/.config/tpl.conf"

    print "🧪 self-test fixture with deliberate drift"
    let r = (run_check $df $hm true)
    let v = ($r.drift | reduce -f {} {|row, acc| $acc | merge { ($row.entry): $row.verdict } })

    let checks = [
        { name: "exit code is 1 on drift",            pass: ($r.exit_code == 1) }
        { name: "evaluated 8 files (macos excluded)", pass: ($r.evaluated == 8) }
        { name: "good symlink is OK (not in drift)",  pass: (($v | get -o "good.txt") == null) }
        { name: "dir entry file is OK",               pass: (($v | get -o "hooks") == null) }
        { name: "template file is OK",                pass: (($v | get -o "tpl.conf") == null) }
        { name: "regular file → NOT-SYMLINK",         pass: (($v | get -o "bad.txt") == "NOT-SYMLINK") }
        { name: "missing target → TGT-MISSING",       pass: (($v | get -o "gone.txt") == "TGT-MISSING") }
        { name: "wrong link → WRONG-TARGET",          pass: (($v | get -o "wrong.txt") == "WRONG-TARGET") }
        { name: "dangling link → BROKEN-LINK",        pass: (($v | get -o "broken.txt") == "BROKEN-LINK") }
        { name: "absent source → SRC-MISSING",        pass: (($v | get -o "ghost.txt") == "SRC-MISSING") }
    ]

    print "🧪 self-test fixture with nothing to check"
    '[shared.files]' | save --force $"($df)/.dotter/global.toml"
    let r2 = (run_check $df $hm true)
    let checks = ($checks | append { name: "zero mappings → exit 2, never clean", pass: ($r2.exit_code == 2) })

    rm -rf $root

    for c in $checks {
        let mark = if $c.pass { "✅" } else { "❌" }
        print $"($mark) ($c.name)"
    }
    let failed = ($checks | where pass == false | length)
    if $failed == 0 {
        print $"✅ self-test passed: the checker can fail \(($checks | length) assertions\)"
        0
    } else {
        print $"❌ self-test FAILED: ($failed) of ($checks | length) assertions"
        1
    }
}
