#!/bin/bash
# Helper for Space+W — open wiki link in the pane this script was launched in
# (typically: zellij run --direction right -- hx-wiki-open-right).
# Resolve the IPC bridge; never edit via the symlink path itself.

bridge=/tmp/helix-current-link.md

if [ -L "$bridge" ]; then
    target=$(readlink "$bridge")
    if [ -z "$target" ] || [ ! -e "$target" ]; then
        echo "Error: wiki bridge symlink is broken: $target" >&2
        sleep 2
        exit 1
    fi
elif [ -f "$bridge" ]; then
    target=$bridge
else
    echo "Error: $bridge not found" >&2
    sleep 2
    exit 1
fi

exec "${HOME}/.local/bin/hx" "$target"
