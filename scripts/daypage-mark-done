#!/usr/bin/env nu
# Mark a client as attended in a DayPage.
# Queues a DONE instruction for Helix Space+U to import.
# Changes "- [ ] CLIENT_ID ..." to "- [x] CLIENT_ID ..." in the clinic section.
#
# Usage: daypage-mark-done "XX00"
#        daypage-mark-done "XX00" --date 2026-02-26
# Flush: Space+U in Helix

def main [
    client_id: string
    --date (-d): string  # Target date (YYYY-MM-DD), defaults to today
] {
    let target = if ($date | is-empty) {
        date now | format date "%Y-%m-%d"
    } else {
        $date
    }
    ^wiki-link-service daypage-queue $target $"DONE:($client_id)"
    if $env.LAST_EXIT_CODE != 0 { error make { msg: "Could not queue DayPage completion" } }
}
