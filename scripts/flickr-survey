#!/usr/bin/env python3
"""flickr-survey — inventory a Flickr photostream without downloading it.

Answers the three questions that gate the photo-archive project
(see ~/Assistants/shared/PHOTO-ARCHIVE-STRATEGY.md):

  1. How many photographs are there, and how are they distributed by year?
     -> Is Flickr the primary archive, or only the pre-2017 gap-filler?
  2. How many have a genuine ORIGINAL available, and at what dimensions?
     -> Detects resize-on-upload, which "Original" in the UI does not prove.
  3. How many bytes per year?
     -> Sizes the export and the Hetzner repository per era.

It downloads no image data. The whole photostream is enumerated with
flickr.people.getPhotos using `extras`, so ~70,000 photos costs ~140 API
calls rather than one call per photo. Optional --sample-sizes issues HEAD
requests against a random sample of originals to build a bytes-per-year
profile; only headers are fetched, never image bodies.

Pure Python 3 standard library: no pip installs, runs on the Mac and nimbini.

USAGE
  flickr-survey auth                    # one-time OAuth setup
  flickr-survey survey                  # enumerate -> JSONL + summary
  flickr-survey survey --sample-sizes 300
  flickr-survey report                  # re-analyse the JSONL, no API calls

CREDENTIALS
  Get a free, self-service, non-commercial API key at
  https://www.flickr.com/services/apps/create/apply
  then run `flickr-survey auth`. Credentials are stored 0600 at
  ~/.config/flickr-survey/credentials and are never echoed.
"""

import argparse
import base64
import collections
import hashlib
import hmac
import json
import os
import random
import re
import statistics
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

CONFIG_DIR = os.path.expanduser("~/.config/flickr-survey")
CRED_PATH = os.path.join(CONFIG_DIR, "credentials")
DEFAULT_OUT = os.path.expanduser("~/flickr-survey.jsonl")

REST = "https://api.flickr.com/services/rest/"
REQ_TOKEN = "https://www.flickr.com/services/oauth/request_token"
AUTHORIZE = "https://www.flickr.com/services/oauth/authorize"
ACC_TOKEN = "https://www.flickr.com/services/oauth/access_token"

# One call returns everything we need per photo. Adding fields here is free;
# adding an extra API call per photo is not.
EXTRAS = "date_taken,o_dims,url_o,original_format,media,date_upload"

PER_PAGE = 500  # Flickr's maximum


# ---------------------------------------------------------------- credentials

def load_creds():
    if not os.path.exists(CRED_PATH):
        die(f"No credentials at {CRED_PATH}.\n"
            f"Get a key at https://www.flickr.com/services/apps/create/apply\n"
            f"then run:  flickr-survey auth")
    with open(CRED_PATH) as f:
        creds = json.load(f)
    for k in ("api_key", "api_secret"):
        if not creds.get(k):
            die(f"credentials file is missing {k!r} — rerun `flickr-survey auth`")
    return creds


def save_creds(creds):
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    tmp = CRED_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(creds, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, CRED_PATH)
    os.chmod(CRED_PATH, 0o600)


def die(msg, code=1):
    print(f"flickr-survey: {msg}", file=sys.stderr)
    sys.exit(code)


# ------------------------------------------------------------- OAuth 1.0a

def _quote(s):
    return urllib.parse.quote(str(s), safe="~")


def sign(method, url, params, consumer_secret, token_secret=""):
    """OAuth 1.0a HMAC-SHA1. Flickr requires this for private photos."""
    norm = "&".join(f"{_quote(k)}={_quote(params[k])}" for k in sorted(params))
    base = f"{method}&{_quote(url)}&{_quote(norm)}"
    key = f"{_quote(consumer_secret)}&{_quote(token_secret)}"
    mac = hmac.new(key.encode(), base.encode(), hashlib.sha1)
    return base64.b64encode(mac.digest()).decode()


def oauth_params(api_key, token=None):
    p = {
        "oauth_consumer_key": api_key,
        "oauth_nonce": hashlib.sha1(os.urandom(32)).hexdigest(),
        "oauth_signature_method": "HMAC-SHA1",
        "oauth_timestamp": str(int(time.time())),
        "oauth_version": "1.0",
    }
    if token:
        p["oauth_token"] = token
    return p


def http_get(url, params, retries=5):
    """GET with backoff. Flickr rate-limits at ~3600 queries/hour."""
    full = f"{url}?{urllib.parse.urlencode(params)}"
    delay = 2.0
    last = None
    for attempt in range(retries):
        try:
            req = urllib.request.Request(full, headers={"User-Agent": "flickr-survey/1.0"})
            with urllib.request.urlopen(req, timeout=60) as r:
                return r.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            last = e
            # 429/5xx are worth retrying; 4xx generally are not.
            if e.code not in (429, 500, 502, 503, 504):
                raise
        except (urllib.error.URLError, TimeoutError) as e:
            last = e
        if attempt < retries - 1:
            time.sleep(delay)
            delay *= 2
    raise last


def api(creds, method, **kwargs):
    """Signed call to the Flickr REST API, returning parsed JSON."""
    params = oauth_params(creds["api_key"], creds.get("oauth_token"))
    params.update({
        "method": method,
        "format": "json",
        "nojsoncallback": "1",
        **{k: v for k, v in kwargs.items() if v is not None},
    })
    params["oauth_signature"] = sign(
        "GET", REST, params, creds["api_secret"], creds.get("oauth_token_secret", "")
    )
    body = http_get(REST, params)
    data = json.loads(body)
    if data.get("stat") != "ok":
        die(f"API error on {method}: {data.get('code')} {data.get('message')}")
    return data


def cmd_auth(args):
    """One-time OAuth 1.0a dance, out-of-band (no callback server needed)."""
    print("Flickr API key setup.")
    print("If you do not have one yet, apply (free, instant, non-commercial) at:")
    print("  https://www.flickr.com/services/apps/create/apply\n")
    existing = {}
    if os.path.exists(CRED_PATH):
        with open(CRED_PATH) as f:
            existing = json.load(f)
    api_key = input(f"API key{' [keep existing]' if existing.get('api_key') else ''}: ").strip()
    api_key = api_key or existing.get("api_key", "")
    api_secret = input(f"API secret{' [keep existing]' if existing.get('api_secret') else ''}: ").strip()
    api_secret = api_secret or existing.get("api_secret", "")
    if not api_key or not api_secret:
        die("both key and secret are required")

    # 1. request token
    p = oauth_params(api_key)
    p["oauth_callback"] = "oob"
    p["oauth_signature"] = sign("GET", REQ_TOKEN, p, api_secret, "")
    resp = urllib.parse.parse_qs(http_get(REQ_TOKEN, p))
    if "oauth_token" not in resp:
        die(f"request-token failed: {resp}")
    rt, rts = resp["oauth_token"][0], resp["oauth_token_secret"][0]

    # 2. user authorises in a browser, gets a verifier
    print("\nOpen this URL, approve READ access, and copy the 9-digit code:\n")
    print(f"  {AUTHORIZE}?{urllib.parse.urlencode({'oauth_token': rt, 'perms': 'read'})}\n")
    verifier = input("Verifier code: ").strip().replace("-", "")

    # 3. exchange for an access token
    p = oauth_params(api_key, rt)
    p["oauth_verifier"] = verifier
    p["oauth_signature"] = sign("GET", ACC_TOKEN, p, api_secret, rts)
    resp = urllib.parse.parse_qs(http_get(ACC_TOKEN, p))
    if "oauth_token" not in resp:
        die(f"access-token exchange failed: {resp}")

    save_creds({
        "api_key": api_key,
        "api_secret": api_secret,
        "oauth_token": resp["oauth_token"][0],
        "oauth_token_secret": resp["oauth_token_secret"][0],
        "nsid": resp.get("user_nsid", [""])[0],
        "username": resp.get("username", [""])[0],
    })
    print(f"\n✅ Authorised as {resp.get('username', ['?'])[0]}. "
          f"Credentials saved 0600 to {CRED_PATH}")
    print("Next:  flickr-survey survey")


# ------------------------------------------------------------------- survey

def cmd_survey(args):
    creds = load_creds()
    if not creds.get("oauth_token"):
        die("not authorised — run `flickr-survey auth` first")
    nsid = creds.get("nsid") or "me"

    out_path = os.path.expanduser(args.out)
    records = []
    page = 1
    pages = None
    total = None

    print(f"Enumerating photostream (up to {PER_PAGE} per call)…", file=sys.stderr)
    with open(out_path, "w") as out:
        while True:
            data = api(creds, "flickr.people.getPhotos", user_id=nsid,
                       per_page=PER_PAGE, page=page, extras=EXTRAS)
            ph = data["photos"]
            pages = int(ph["pages"])
            total = int(ph["total"])
            for p in ph["photo"]:
                rec = {
                    "id": p.get("id"),
                    "title": p.get("title", "")[:120],
                    "taken": p.get("datetaken"),
                    "uploaded": p.get("dateupload"),
                    "media": p.get("media"),
                    "format": p.get("originalformat"),
                    "w": int(p["width_o"]) if str(p.get("width_o", "")).isdigit() else None,
                    "h": int(p["height_o"]) if str(p.get("height_o", "")).isdigit() else None,
                    "url_o": p.get("url_o"),
                }
                records.append(rec)
                out.write(json.dumps(rec) + "\n")
            print(f"  page {page}/{pages}  ({len(records):,}/{total:,})", file=sys.stderr)
            if page >= pages:
                break
            page += 1
            time.sleep(args.delay)

    print(f"\nWrote {len(records):,} records to {out_path}", file=sys.stderr)

    if args.sample_sizes:
        sample_sizes(records, args.sample_sizes, out_path)

    summarise(records)


def sample_sizes(records, n, out_path):
    """HEAD a random sample of originals to build a bytes-per-year profile.

    Headers only — no image data is downloaded. Results are merged back into
    the JSONL so `report` can use them without re-fetching.
    """
    have = [r for r in records if r.get("url_o")]
    if not have:
        print("No original URLs available — cannot sample sizes.", file=sys.stderr)
        return
    n = min(n, len(have))
    print(f"\nSampling {n} original file sizes (HEAD only)…", file=sys.stderr)
    sample = random.sample(have, n)
    sizes = {}
    for i, r in enumerate(sample, 1):
        try:
            req = urllib.request.Request(
                r["url_o"], method="HEAD",
                headers={"User-Agent": "flickr-survey/1.0"})
            with urllib.request.urlopen(req, timeout=30) as resp:
                cl = resp.headers.get("Content-Length")
                if cl:
                    sizes[r["id"]] = int(cl)
                    r["bytes"] = int(cl)
        except Exception:
            pass  # a failed sample is not worth aborting the run for
        if i % 25 == 0:
            print(f"  {i}/{n}", file=sys.stderr)
        time.sleep(0.1)

    if sizes:
        with open(out_path, "w") as out:
            for r in records:
                out.write(json.dumps(r) + "\n")
        print(f"  got {len(sizes)}/{n} sizes; merged into {out_path}", file=sys.stderr)


def cmd_report(args):
    path = os.path.expanduser(args.out)
    if not os.path.exists(path):
        die(f"no survey at {path} — run `flickr-survey survey` first")
    with open(path) as f:
        records = [json.loads(l) for l in f if l.strip()]
    summarise(records)


# ---------------------------------------------------------------- reporting

def year_of(rec):
    t = rec.get("taken") or ""
    m = re.match(r"(\d{4})", t)
    y = m.group(1) if m else None
    # Flickr returns 0000 for photos with no date; treat as unknown.
    return y if y and y != "0000" else "unknown"


def summarise(records):
    n = len(records)
    if not n:
        print("No records.")
        return

    photos = [r for r in records if r.get("media") != "video"]
    videos = [r for r in records if r.get("media") == "video"]
    with_orig = [r for r in records if r.get("url_o")]
    sized = [r for r in records if r.get("bytes")]

    print("\n" + "=" * 68)
    print("FLICKR SURVEY")
    print("=" * 68)
    print(f"  Total items            {n:>10,}")
    print(f"  — photos               {len(photos):>10,}")
    print(f"  — videos               {len(videos):>10,}")
    print(f"  Original available     {len(with_orig):>10,}  ({len(with_orig)/n*100:.1f}%)")
    if len(with_orig) < n:
        print(f"  ⚠ NO original          {n-len(with_orig):>10,}  "
              f"— these cannot be recovered at full resolution")

    # --- by year -----------------------------------------------------------
    by_year = collections.Counter(year_of(r) for r in records)
    orig_by_year = collections.Counter(year_of(r) for r in with_orig)
    bytes_by_year = collections.defaultdict(list)
    for r in sized:
        bytes_by_year[year_of(r)].append(r["bytes"])

    print("\n  BY YEAR")
    print(f"  {'year':<9}{'items':>9}{'w/orig':>9}{'avg MB':>9}{'est GB':>9}")
    print("  " + "-" * 45)
    est_total = 0.0
    for y in sorted(by_year, key=lambda k: (k == "unknown", k)):
        cnt = by_year[y]
        oc = orig_by_year.get(y, 0)
        samples = bytes_by_year.get(y, [])
        if samples:
            avg = statistics.mean(samples) / 1048576
            est = cnt * avg / 1024
            est_total += est
            print(f"  {y:<9}{cnt:>9,}{oc:>9,}{avg:>9.2f}{est:>9.1f}")
        else:
            print(f"  {y:<9}{cnt:>9,}{oc:>9,}{'—':>9}{'—':>9}")
    if est_total:
        print("  " + "-" * 45)
        print(f"  {'TOTAL':<9}{n:>9,}{len(with_orig):>9,}{'':>9}{est_total:>9.1f}")
        print(f"\n  Cross-check this estimate against the figure at")
        print(f"  flickr.com/photos/<user>/stats — they should broadly agree.")

    # --- resize-on-upload detection ---------------------------------------
    dims = [(r["w"], r["h"]) for r in records if r.get("w") and r.get("h")]
    if dims:
        mp = sorted((w * h) / 1e6 for w, h in dims)
        # These are the classic web-resize dimensions. Their presence in bulk
        # means the upload path downsized, and the "Original" is not the
        # camera's file — see PHOTO-ARCHIVE-STRATEGY.md § 3.9.
        suspicious = {(1024, 768), (768, 1024), (2048, 1536), (1536, 2048),
                      (1600, 1200), (1200, 1600), (640, 480), (500, 375)}
        resized = sum(1 for d in dims if d in suspicious)
        print("\n  RESOLUTION")
        print(f"    megapixels  min {mp[0]:.1f}   median {mp[len(mp)//2]:.1f}   max {mp[-1]:.1f}")
        print(f"    at classic web-resize dimensions: {resized:,} "
              f"({resized/len(dims)*100:.1f}%)")
        if resized / len(dims) > 0.05:
            print("    🚨 Significant resize-on-upload. Those items are NOT camera")
            print("       originals, whatever the Flickr UI labels them.")
        else:
            print("    ✅ No mass resize-on-upload detected.")

    fmts = collections.Counter(r.get("format") or "?" for r in records)
    print("\n  FORMATS  " + "  ".join(f"{k}={v:,}" for k, v in fmts.most_common(6)))
    print("=" * 68)


# ---------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(
        prog="flickr-survey",
        description="Inventory a Flickr photostream without downloading it.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("auth", help="one-time OAuth setup")

    s = sub.add_parser("survey", help="enumerate the photostream")
    s.add_argument("--out", default=DEFAULT_OUT, help=f"JSONL output (default {DEFAULT_OUT})")
    s.add_argument("--sample-sizes", type=int, metavar="N", default=0,
                   help="HEAD N random originals to estimate bytes per year")
    s.add_argument("--delay", type=float, default=0.5,
                   help="seconds between pages (default 0.5)")

    r = sub.add_parser("report", help="re-analyse an existing survey, no API calls")
    r.add_argument("--out", default=DEFAULT_OUT)

    args = ap.parse_args()
    {"auth": cmd_auth, "survey": cmd_survey, "report": cmd_report}[args.cmd](args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
