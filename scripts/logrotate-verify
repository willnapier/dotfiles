#!/usr/bin/env bash
# logrotate-verify — confirm a logrotate run did what it should, and in
# particular that it did NOT silently kill logging.
#
# The failure mode this exists to catch: a LONG-RUNNING service that writes via
# systemd StandardOutput=append: has the file open for its whole life. If a rule
# ever loses `copytruncate`, rotation renames the file, the service keeps writing
# to the renamed-or-unlinked inode, and the new log stays empty FOREVER. Rotation
# looks configured; logging is dead. Nothing else would tell you.
#
# That premise is narrower than it looks, and the check below is scoped to match
# it (corrected 2026-08-28). Only a long-running unit can be stranded:
#   - Type=oneshot/timer units (gmpull, cohs-trash-mover, gmail-push-tags, ...)
#     reopen the append: target BY PATH on every start, so a rename cannot
#     outlive a single run.
#   - Several logs have no append: unit at all and are opened-appended-closed by
#     the script itself: git-auto-pull-watcher.service is StandardOutput=journal
#     and writes its log from nu (git-auto-pull-watcher:63); continuum/sync.log
#     and continuum/auto-import.log are named by no unit whatsoever.
# For all of those, rotation cannot strand the writer and a quiet log is just a
# quiet log. Today only mailforge, forum-worker and dotter-realtime-watcher are
# long-running append: units.
#
# So this does NOT test "has the log been written to lately" — that was the old
# check, and it is the wrong question twice over: it fired on event-driven logs
# that were merely idle (git-auto-pull-watcher, 2026-08-28) while never looking
# at the only services that can actually fail. A guard that cries wolf on healthy
# state trains you to ignore it. Instead it tests the condition DIRECTLY: every
# open log fd must point at the path it is supposed to, not at an archive or a
# deleted inode.
#
# See ~/Assistants/shared/NIMBINI-LOG-ROTATION.md
#
# Usage: logrotate-verify        exit 0 = all good, 1 = something to look at

set -uo pipefail
S=~/.local/share
fail=0
note() { printf '  %-46s %s\n' "$1" "$2"; }
bad()  { printf '  %-46s ** %s **\n' "$1" "$2"; fail=1; }

# Mail logs: rotate 0 (must never keep archives) and must be 0600.
MAIL="gmpull.log mail-sync.log mailforge.log cohs-trash-mover.log
      mailcurator-drift.log gmail-push-tags.log gmail-push-tags-watchdog.log"
# Non-mail: rotate 2, archives are expected and fine.
OTHER="git-auto-pull-watcher.log git-auto-push-watcher.log
       continuum/sync.log continuum/auto-import.log"

echo "== logrotate service =="
last=$(systemctl show logrotate.service -p ExecMainStatus --value 2>/dev/null)
when=$(systemctl show logrotate.service -p ExecMainExitTimestamp --value 2>/dev/null)
[ "${last:-0}" = "0" ] && note "last run exit status" "0 (ok) — ${when:-unknown}" \
                       || bad  "last run exit status" "$last — ${when:-unknown}"

echo
echo "== mail logs: must be 0600, must have NO archives =="
for f in $MAIL; do
    p="$S/$f"; [ -e "$p" ] || { note "$f" "absent (fine)"; continue; }
    mode=$(stat -c%a "$p")
    [ "$mode" = "600" ] && note "$f mode" "0600" || bad "$f mode" "0$mode — should be 0600"
    arch=$(ls "$p".* 2>/dev/null | wc -l)
    [ "$arch" -eq 0 ] && note "$f archives" "none (correct for rotate 0)" \
                      || bad  "$f archives" "$arch present — rotate 0 violated, may contain mail data"
done

echo
echo "== non-mail logs: archives allowed, mode still 0600 =="
for f in $OTHER; do
    p="$S/$f"; [ -e "$p" ] || { note "$f" "absent (fine)"; continue; }
    mode=$(stat -c%a "$p")
    [ "$mode" = "600" ] && note "$f mode" "0600" || bad "$f mode" "0$mode"
    note "$f archives" "$(ls "$p".* 2>/dev/null | wc -l) (rotate 2 allows up to 2)"
done

echo
echo "== copytruncate: does every open log fd still point at its live path? =="
# Own processes only, so no sudo: these are all systemd USER units.
held=0
for fd in /proc/[0-9]*/fd/*; do
    tgt=$(readlink "$fd" 2>/dev/null) || continue
    case "$tgt" in "$S"/*) ;; *) continue ;; esac
    # Logs only. Daemons under $S also hold sqlite/localstorage handles
    # (handy), which no rule rotates and which would be pure noise here.
    case "$tgt" in
        *.log|*.stdout|*.stderr|*' (deleted)'|*.log.[0-9]|*.stdout.[0-9]|*.stderr.[0-9]) ;;
        *) continue ;;
    esac
    pid=${fd#/proc/}; pid=${pid%%/*}
    comm=$(cat "/proc/$pid/comm" 2>/dev/null || echo '?')
    held=$((held + 1))
    short=${tgt#"$S"/}
    case "$tgt" in
        *' (deleted)')
            bad "$comm[$pid]" "writing to DELETED ${short% (deleted)} — rotation renamed instead of truncating" ;;
        *.[0-9]|*.[0-9].gz)
            bad "$comm[$pid]" "writing to ARCHIVE $short — rotation renamed instead of truncating" ;;
        *)
            note "$comm[$pid]" "$short (live)" ;;
    esac
done
[ "$held" -eq 0 ] && note "open log fds" "none held — nothing can be stranded"

echo
if [ "$fail" -eq 0 ]; then echo "RESULT: clean"; else
    echo "RESULT: needs attention"
    echo "For a stranded writer, confirm independently with:  sudo lsof +L1 | rg .local/share"
    echo "Fix is to restore copytruncate in the rule, then restart that unit."
fi
exit $fail
