#!/bin/bash
# Move most recent SingleFile save and output wikilink for Helix insertion
SOURCE=~/Downloads
DEST=~/Captures/web-archives

mkdir -p "$DEST"

# Find most recent SingleFile HTML (date-prefixed)
latest=$(ls -t "$SOURCE"/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.html 2>/dev/null | head -1)

if [ -z "$latest" ]; then
    echo "No web clip found in Downloads" >&2
    exit 1
fi

filename=$(basename "$latest")
mv "$latest" "$DEST/"

# Output wikilink (Helix will insert this). The name comes off the filesystem,
# which macOS lists in NFD; link text must be NFC (meta-nfc-boundary-rollout).
# This is an HTML capture, not a note, so `wiki-link-service link-for` does not
# apply — normalise with python3 (present on both hosts).
nfc_name=$(python3 -c 'import sys,unicodedata;print(unicodedata.normalize("NFC",sys.argv[1]))' "$filename")
echo "[[captures/web-archives/$nfc_name]]"
