{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/continuum-grok",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/continuum-grok",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
