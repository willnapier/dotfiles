<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.williamnapier.assistants-auto-push</string>

    <!-- The legacy label is retained for migration compatibility. This job is
         now an exact-tree follower and has no commit or push authority. -->

    <key>ProgramArguments</key>
    <array>
        <string>/Users/williamnapier/.local/bin/assistants-git-sync</string>
        <string>--role</string>
        <string>follower</string>
        <string>--expected-host</string>
        <string>Williams-MacBook-Air.local</string>
        <string>--repo</string>
        <string>/Users/williamnapier/Assistants</string>
        <string>--log</string>
        <string>/Users/williamnapier/.local/share/assistants-git-sync-follower.log</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/williamnapier/.local/share/assistants-git-sync-follower.stdout</string>

    <key>StandardErrorPath</key>
    <string>/Users/williamnapier/.local/share/assistants-git-sync-follower-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/Users/williamnapier/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/williamnapier</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>15</integer>
</dict>
</plist>
