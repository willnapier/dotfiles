<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.williamnapier.tm3-diary-live</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>/Users/williamnapier/.local/bin/tm3-cookie-sync; /Users/williamnapier/.local/bin/tm3-diary-capture --live; /Users/williamnapier/.local/bin/practiceforge sync-docs</string>
    </array>

    <!-- Hourly during clinic hours (07:00-22:00) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/williamnapier/.local/share/tm3-diary-live.stdout</string>

    <key>StandardErrorPath</key>
    <string>/Users/williamnapier/.local/share/tm3-diary-live.stderr</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/williamnapier/.local/bin:/Users/williamnapier/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/williamnapier</string>
        <!-- DUMP_HTML=1 REMOVED 2026-07-29. It was forensic instrumentation for
             the cross-day-attribution bug (handoff 2026-05-28), dumping ~16MB of
             raw TM3 diary HTML per capture to /tmp/tm3-live-dump-YYYY-MM-DD.html
             — i.e. an uncapped PHI sink. Its own removal condition was "once the
             extract_day_columns root-cause fix lands and one clean week passes".
             That fix landed 2026-06-19 (tm3-diary-capture df038d7, "scope
             offered-red detection PER DAY"), is in main, and the deployed binary
             dates from 23 Jun — five clean weeks. Condition met; sink closed.
             If the bug ever recurs, re-add the key rather than reinventing it. -->
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>15</integer>
</dict>
</plist>
