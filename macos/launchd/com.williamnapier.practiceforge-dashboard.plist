<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.williamnapier.practiceforge-dashboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/williamnapier/.local/bin/practiceforge</string>
        <string>admin-dashboard</string>
        <string>--port</string>
        <string>3457</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/williamnapier/.local/share/practiceforge/dashboard-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/williamnapier/.local/share/practiceforge/dashboard-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/williamnapier/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- NB: do NOT add PF_DEV=1 here. PF_DEV shifts the dashboard from
             port 3457 to 3458 (port+1, for dev/prod side-by-side running),
             which would break every bookmark and link. For frontend
             iteration, run a second dashboard manually with PF_DEV=1 on
             port 3458, leaving prod 3457 untouched. -->
        <!-- DUMP_HTML=1 REMOVED 2026-07-29. It was forensic instrumentation for
             the cross-day-attribution bug (handoff 2026-05-28), inherited by
             tm3-diary-capture --live subprocesses from the dashboard's TM3
             refresh flow and dumping raw TM3 diary HTML to
             /tmp/tm3-live-dump-YYYY-MM-DD.html — i.e. an uncapped PHI sink.
             Its own removal condition was "once the extract_day_columns
             root-cause fix lands and one clean week passes". That fix landed
             2026-06-19 (tm3-diary-capture df038d7), is in main, and the deployed
             binary dates from 23 Jun — five clean weeks. Condition met; sink
             closed. If the bug recurs, re-add the key rather than reinventing it. -->
    </dict>
</dict>
</plist>
