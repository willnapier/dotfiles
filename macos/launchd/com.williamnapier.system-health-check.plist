<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.williamnapier.system-health-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/williamnapier/.local/bin/system-health-check</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/williamnapier/.local/share/system-health-check.stdout</string>

    <key>StandardErrorPath</key>
    <string>/Users/williamnapier/.local/share/system-health-check.stderr</string>

    <!-- ~/.local/bin and ~/.cargo/bin are load-bearing: the checker shells out to
         state-capture and dotter-drift-monitor and reports "not in PATH (check
         skipped)" without them. The old Nushell version hid this because nu
         rebuilds PATH from its own config at startup; the Rust binary uses
         launchd's environment as given (found 2026-09-01). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/williamnapier/.local/bin:/Users/williamnapier/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/williamnapier</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>15</integer>
</dict>
</plist>
