<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.williamnapier.link-service</string>
    <!-- wiki-link-service (Rust, 2026-09-02): runs the backlinks and resolve-mark watchers as two
         threads of one foreground process, so launchd supervises it directly. Replaces the Nushell
         link-service + wiki-backlinks + wiki-resolve-mark trio and the legacy wiki-link-manager agent. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/williamnapier/.local/bin/wiki-link-service</string>
        <string>start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/williamnapier/.local/share/link-service/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/williamnapier/.local/share/link-service/launchd-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/williamnapier/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
