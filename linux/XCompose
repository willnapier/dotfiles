# Custom compose sequences
# Include system defaults first
include "%L"

# British Pound Sterling (£)
# Menu, L, - or Menu, -, L
<Multi_key> <L> <minus> : "£" U00A3
<Multi_key> <minus> <L> : "£" U00A3
<Multi_key> <l> <minus> : "£" U00A3
<Multi_key> <minus> <l> : "£" U00A3

# Shift-tolerant variants (2026-08-27)
# NUM+Shift+D on the Totem/Temper Linux keymaps fires pound_macro from under a
# held Shift. The mod-morph masks Shift, but re-registers it on key release —
# which can land mid-macro on a quick tap, turning the trailing `-` into `_`.
# Accepting `_` as well makes the sequence resolve to £ whatever the shift state.
# See ~/Assistants/shared/ZMK-SYMBOL-LAYER.md §4.
<Multi_key> <L> <underscore> : "£" U00A3
<Multi_key> <l> <underscore> : "£" U00A3
<Multi_key> <underscore> <L> : "£" U00A3
<Multi_key> <underscore> <l> : "£" U00A3
